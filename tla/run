#!/bin/sh
set -eu

dir="$(cd "$(dirname "$0")" && pwd)"
tlc_version="1.7.4"
jar="$dir/tla2tools-$tlc_version.jar"
jar_url="https://github.com/tlaplus/tlaplus/releases/download/v$tlc_version/tla2tools.jar"

if [ $# -eq 0 ]; then
  echo "usage: tla/run <config>... | tla/run all | tla/run check" >&2
  echo "       config is a .cfg basename, e.g. ReleasedClaim_nocrash" >&2
  echo "       check runs every config and compares against tla/expected.tsv" >&2
  exit 2
fi

if [ ! -f "$jar" ]; then
  echo "fetching tla2tools.jar v$tlc_version ..." >&2
  curl -fsSL -o "$jar" "$jar_url"
fi

tlc() {
  cfg="$1"
  module="${cfg%%_*}"
  java -XX:+UseParallelGC -cp "$jar" tlc2.TLC \
    -deadlock -workers auto -metadir "$dir/states" \
    -config "$dir/$cfg.cfg" "$dir/$module.tla"
}

# TLC's exit codes: 0 = no error, 10-13 = a violation the model checker
# found, anything else = TLC itself failed (parse error, bad config, OOM).
# Mapping every nonzero exit to VIOLATED would let a broken spec match an
# expected-VIOLATED row and pass CI without checking anything.
result_of() {
  set +e
  tlc "$1" > "$2" 2>&1
  code=$?
  set -e

  case $code in
    0) echo PASS ;;
    10 | 11 | 12 | 13) echo VIOLATED ;;
    *) echo "ERROR($code)" ;;
  esac
}

if [ "$1" = "check" ]; then
  status=0
  for path in "$dir"/*.cfg; do
    cfg="$(basename "$path" .cfg)"
    expected="$(awk -F'\t' -v c="$cfg" '$1 == c { print $2 }' "$dir/expected.tsv")"
    out="$(mktemp)"

    if [ -z "$expected" ]; then
      printf '%-36s MISSING from expected.tsv\n' "$cfg"
      status=1
      rm -f "$out"
      continue
    fi

    actual="$(result_of "$cfg" "$out")"

    if [ "$actual" = "$expected" ]; then
      printf '%-36s %s (as expected)\n' "$cfg" "$actual"
    else
      printf '%-36s %s (EXPECTED %s)\n' "$cfg" "$actual" "$expected"
      sed 's/^/    /' "$out"
      status=1
    fi

    rm -f "$out"
  done

  while IFS="$(printf '\t')" read -r cfg _expected; do
    if [ -n "$cfg" ] && [ ! -f "$dir/$cfg.cfg" ]; then
      printf '%-36s listed in expected.tsv but has no .cfg\n' "$cfg"
      status=1
    fi
  done < "$dir/expected.tsv"

  exit $status
fi

if [ "$1" = "all" ]; then
  set -- $(cd "$dir" && ls *.cfg | sed 's/\.cfg$//')
fi

status=0
for cfg in "$@"; do
  printf '== %s (module %s) ==\n' "$cfg" "${cfg%%_*}"
  out="$(mktemp)"
  outcome="$(result_of "$cfg" "$out")"
  cat "$out"
  rm -f "$out"
  printf '== %s: %s ==\n\n' "$cfg" "$outcome"
  [ "$outcome" = "PASS" ] || status=1
done
exit $status
