#!/bin/sh

# containerd commonly runs containers with an effectively unlimited
# file-descriptor limit (a kind node reports 2^30). The BEAM sizes its port
# table from ulimit -n, which turns that into a multi-gigabyte allocation at
# boot — OOM-killed before the first log line. Cap it unless already set.
export ERL_MAX_PORTS="${ERL_MAX_PORTS:-65536}"

if [ -z "${RELEASE_DISTRIBUTION:-}" ] && [ -n "${POD_NAME:-}" ] && [ -n "${POD_NAMESPACE:-}" ]; then
  export RELEASE_DISTRIBUTION=name

  # Single cluster uses the headless-service DNS, which is exactly the
  # address Smolquery.QueryService.Planner derives a buffer node's HotServer
  # URL from (Milestone 8 L5) — the node name has to already be that
  # address, not just resolvable to it via some other mechanism.
  if [ -n "${RELEASE_NODE_HOST:-}" ]; then
    export RELEASE_NODE="smolquery@${RELEASE_NODE_HOST}"
  else
    export RELEASE_NODE="smolquery@${POD_NAME}.${HEADLESS_SERVICE:-smolquery-headless}.${POD_NAMESPACE}.svc.cluster.local"
  fi
fi

# The buffer fleet the deployment expects, as node names, for
# Smolquery.BufferService.Routing.manifest_nodes/1 (T-94): a reader has to be
# able to tell a crashed buffer node from one that drained and left on purpose,
# and :pg membership loses both the same way. Derived from the StatefulSet's
# replica count so it carries no hardcoded namespace, and so scaling the fleet
# is one number; SMOLQUERY_BUFFER_NODES set explicitly wins, for deployments
# whose node names are not pod DNS.
if [ -n "${SMOLQUERY_BUFFER_REPLICAS:-}" ] && [ -z "${SMOLQUERY_BUFFER_NODES:-}" ] && [ -n "${POD_NAMESPACE:-}" ]; then
  _buffer_prefix="${SMOLQUERY_BUFFER_STATEFULSET:-smolquery-buffer}"
  _buffer_svc="${HEADLESS_SERVICE:-smolquery-headless}"
  _buffer_nodes=""
  _buffer_i=0

  while [ "$_buffer_i" -lt "$SMOLQUERY_BUFFER_REPLICAS" ]; do
    _buffer_nodes="${_buffer_nodes:+$_buffer_nodes,}smolquery@${_buffer_prefix}-${_buffer_i}.${_buffer_svc}.${POD_NAMESPACE}.svc.cluster.local"
    _buffer_i=$((_buffer_i + 1))
  done

  export SMOLQUERY_BUFFER_NODES="$_buffer_nodes"
fi

# Erlang distribution over TLS (cluster membership only — buffer/query
# traffic goes over gen_rpc, which has its own TLS switch, GEN_RPC_TLS).
# Uses the same per-node certificates as gen_rpc.
if [ "${DIST_TLS:-}" = "true" ] || [ "${DIST_TLS:-}" = "1" ]; then
  NODE_CERT="${POD_NAME:-${HOSTNAME:?DIST_TLS requires POD_NAME (or HOSTNAME) to name this node's certificate}}"
  TLS_DIR="${GEN_RPC_TLS_DIR:-/etc/smolquery/gen-rpc-tls}"
  DIST_TLS_CONF="${RELEASE_TMP:-/tmp}/inet_tls.conf"
  cat > "$DIST_TLS_CONF" <<CONF
[{server, [{certfile, "$TLS_DIR/${NODE_CERT}.pem"},
           {keyfile, "$TLS_DIR/${NODE_CERT}.key"},
           {cacertfile, "$TLS_DIR/ca.pem"},
           {verify, verify_peer},
           {fail_if_no_peer_cert, true}]},
 {client, [{certfile, "$TLS_DIR/${NODE_CERT}.pem"},
           {keyfile, "$TLS_DIR/${NODE_CERT}.key"},
           {cacertfile, "$TLS_DIR/ca.pem"},
           {verify, verify_peer}]}].
CONF
  export ELIXIR_ERL_OPTIONS="-proto_dist inet_tls -ssl_dist_optfile $DIST_TLS_CONF ${ELIXIR_ERL_OPTIONS:-}"
fi
