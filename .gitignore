# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# DuckDB spill files (temp_directory). A query that exceeds memory_limit writes
# duckdb_temp_storage_*.tmp here, and a bench run can leave tens of gigabytes.
/.tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
smolquery-*.tar


# Claude Code per-user directory: local skill symlinks + git-ignored *.env creds
# (see skills/README.md); nothing under .claude/ is committed.
/.claude/

# Repo-local scoped kubeconfig (pins kubectl to kind-smolquery; holds a client key).
/.kube/

# Dev TLS certs generated by scripts/gen-dev-certs.sh for the kind overlay.
deploy/overlays/kind/tls/
deploy/overlays/kind-symmetric/tls/

# Dialyzer PLTs (cached in CI, not committed)
/priv/plts/

# Dev-run data: buffer manifests, segments, and the DuckLake catalog
/priv/data/

# Built web assets and fetched JS deps (rebuilt by mix assets.build)
/priv/static/assets/
/assets/node_modules/
